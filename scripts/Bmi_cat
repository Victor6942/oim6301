# Breeds are the CFA's most popular list (2018) plus a few more.
# Each breed: (low, high, size group), adult weight in pounds.
# Sources:
#   PetSafe, "How much should my cat weigh": breeds up to Maine Coon.
#   Wikipedia: Bombay, Scottish Fold, Abyssinian, Oriental Shorthair, Siberian,
#              Russian Blue, Burmese (Siberian 4.5-9 kg converted by me).
#   Hill's Pet: Sphynx ("less than 12 lb", stored as 0 to 12).
# Oriental Shorthair females are "less than 8 lb", so it is stored as 0 to 12.
# Other sources differ a little, so these are rough ranges.
breeds = {
    "Ragdoll": (10, 20, "large"),
    "British Shorthair": (9, 18, "large"),
    "Persian": (7, 12, "medium"),
    "Maine Coon": (10, 25, "large"),
    "American Shorthair": (8, 15, "medium"),
    "Scottish Fold": (6, 13, "medium"),
    "Sphynx": (0, 12, "medium"),
    "Devon Rex": (6, 9, "small"),
    "Abyssinian": (8, 12, "medium"),
    "Oriental Shorthair": (0, 12, "medium"),
    "Siamese": (6, 12, "small"),
    "Cornish Rex": (6, 10, "small"),
    "Norwegian Forest Cat": (10, 20, "large"),
    "Siberian": (10, 20, "large"),
    "Russian Blue": (8, 15, "medium"),
    "Bengal": (8, 15, "medium"),
    "Burmese": (9, 13, "medium"),
    "Bombay": (5.5, 11, "medium"),
    "Domestic Shorthair": (8, 12, "medium"),
    "Domestic Longhair": (8, 15, "medium"),
    "Singapura": (4, 8, "small"),
}


def classify_cat(weight, low, high):
    """compare a cat's weight with its breed's healthy range"""
    if weight > high:
        percent = (weight - high) / high * 100
        if percent > 20:
            return f"{percent:.0f}% above the range: Obese"
        elif percent >= 10:
            return f"{percent:.0f}% above the range: Overweight"
        else:
            return f"{percent:.0f}% above the range: just above ideal"
    elif weight >= low:
        return "Within the healthy range"
    else:
        percent = (low - weight) / low * 100
        if percent >= 10:
            return f"{percent:.0f}% below the range: Underweight"
        return f"{percent:.0f}% below the range: just below ideal"


def life_stage(age):
    """ASSUMPTION: kitten under 1 year, senior at 11 or older (varies by cat)"""
    if age < 1:
        return "kitten"
    elif age >= 11:
        return "senior"
    return "adult"


def pounds_to_ideal(weight, low, high):
    """pounds to lose (positive) or gain (negative) to reach the healthy range"""
    if weight > high:
        return weight - high
    elif weight < low:
        return weight - low
    return 0


def main():
    names = list(breeds)
    print("Choose a breed:")
    for i, name in enumerate(names, start=1):
        print(f"  {i:>2}. {name}")
    choice = int(input("Enter the number: "))
    breed = names[choice - 1]
    low, high, size = breeds[breed]

    age = float(input(f"Your {breed}'s age in years (for 6 months, type 0.5): "))
    weight = float(input(f"Your {breed}'s current weight in pounds: "))
    stage = life_stage(age)

    print(f"Breed: {breed}  |  size group: {size}  |  life stage: {stage}")

    if stage == "kitten":
        print(f"The healthy range of {low}-{high} lb is for fully grown adults, so it does not apply to a kitten.")
        print("Ask your vet for a kitten growth chart.")
    else:
        result = classify_cat(weight, low, high)
        change = pounds_to_ideal(weight, low, high)
        print(f"Result: {result}.")
        print(f"Your {breed}'s healthy weight is {low}-{high} lb.")
        if change > 0:
            print(f"To reach the top of the range, your cat would need to lose about {change:.1f} lb.")
        elif change < 0:
            print(f"To reach the bottom of the range, your cat would need to gain about {-change:.1f} lb.")
        else:
            print("Your cat is already in the healthy range.")
        if stage == "senior":
            print("Senior cats can lose muscle with age, so ask your vet to check body condition too.")
    print("This is a rough guide. Ask your vet for your cat's exact target weight.")


main()