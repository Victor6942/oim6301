def compute_bmi(weight, height):
    """compute the Body Mass Index (BMI) given weight in pounds and height in inches"""
    bmi = 703 * weight / (height ** 2)
    return bmi


def classify_bmi(bmi):
    if bmi >= 30:
        category = "Obese"
    elif bmi >= 25:
        category = "Overweight"
    elif bmi >= 18.5:
        category = "Normal"
    else:
        category = "Underweight"
    return category


def main():
    weight = float(input("Enter your weight in pounds: "))
    feet = float(input("Enter your height, feet part (for 5'10\", type 5): "))
    inches = float(input("Enter your height, inches part (for 5'10\", type 10): "))
    height = feet * 12 + inches
    bmi_value = compute_bmi(weight, height)
    result = classify_bmi(bmi_value)
    print(f"Your BMI is {bmi_value:.2f}, and your category is {result}.")


main()